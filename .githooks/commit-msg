#!/usr/bin/env bash
# Rejette tout message de commit mentionnant un outil d'IA ou contenant un emoji.
# Activation : git config core.hooksPath .githooks
set -uo pipefail

MSG_FILE="${1:?chemin du fichier de message attendu}"

ROUGE=$'\033[0;31m'; JAUNE=$'\033[0;33m'; GRIS=$'\033[0;90m'; RAZ=$'\033[0m'

# Motifs interdits : expression régulière étendue, insensible à la casse.
MOTIFS_INTERDITS=(
  'co-authored-by'
  'generated with'
  'generated by'
  'written by (an )?ai'
  'claude'
  'anthropic'
  'chatgpt'
  'openai'
  'gpt-[0-9]'
  'copilot'
  'cursor(\.sh| ide)?'
  'gemini'
  'windsurf'
  'codex'
  'aider'
  'llm-generated'
)

# Emoji : plages Unicode usuelles (pictogrammes, symboles, drapeaux, robot).
MOTIF_EMOJI='[\x{1F000}-\x{1FAFF}\x{2190}-\x{21FF}\x{2600}-\x{27BF}\x{2B00}-\x{2BFF}\x{FE0F}\x{1F1E6}-\x{1F1FF}]'

fautes=0

signaler() {
  local ligne_num="$1" ligne_txt="$2" raison="$3"
  printf '%s  ligne %s%s : %s\n' "$ROUGE" "$ligne_num" "$RAZ" "$raison"
  printf '%s    %s%s\n' "$GRIS" "$ligne_txt" "$RAZ"
  fautes=$((fautes + 1))
}

ligne_num=0
while IFS= read -r ligne || [ -n "$ligne" ]; do
  ligne_num=$((ligne_num + 1))

  # Les lignes de commentaire produites par git ne font pas partie du message.
  case "$ligne" in \#*) continue ;; esac

  for motif in "${MOTIFS_INTERDITS[@]}"; do
    if printf '%s' "$ligne" | grep -qiE "$motif"; then
      signaler "$ligne_num" "$ligne" "mention d'un outil d'IA interdite (motif : $motif)"
      break
    fi
  done

  if printf '%s' "$ligne" | grep -qP "$MOTIF_EMOJI" 2>/dev/null; then
    signaler "$ligne_num" "$ligne" "emoji interdit dans un message de commit"
  fi
done < "$MSG_FILE"

if [ "$fautes" -gt 0 ]; then
  printf '\n%s================================================%s\n' "$ROUGE" "$RAZ"
  printf '%s COMMIT REFUSÉ — %s ligne(s) non conforme(s)%s\n' "$ROUGE" "$fautes" "$RAZ"
  printf '%s================================================%s\n\n' "$ROUGE" "$RAZ"
  printf '%sRègle du projet (docs/02-CONVENTIONS.md) :%s\n' "$JAUNE" "$RAZ"
  printf "  L'historique Git ne mentionne jamais d'outil d'IA, et ne contient aucun emoji.\n"
  printf '  Corrige le message ci-dessus, puis relance le commit.\n\n'
  exit 1
fi

exit 0
