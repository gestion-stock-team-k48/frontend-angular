#!/usr/bin/env bash
# Contrôle du message de commit, en deux passes :
#   1. interdiction des mentions d'outils d'IA et des emoji (règle du projet) ;
#   2. conformité Conventional Commits, déléguée à commitlint.
# Activation : git config core.hooksPath .githooks
set -uo pipefail

MSG_FILE="${1:?chemin du fichier de message attendu}"

ROUGE=$'\033[0;31m'; JAUNE=$'\033[0;33m'; GRIS=$'\033[0;90m'; RAZ=$'\033[0m'

MOTIFS_INTERDITS=(
  'co-authored-by'
  'generated with'
  'generated by'
  'written by (an )?ai'
  'claude'
  'anthropic'
  'chatgpt'
  'openai'
  'gpt-[0-9]'
  'copilot'
  'cursor(\.sh| ide)?'
  'gemini'
  'windsurf'
  'codex'
  'aider'
  'llm-generated'
)

# Emoji : plages Unicode usuelles (pictogrammes, symboles, drapeaux).
MOTIF_EMOJI='[\x{1F000}-\x{1FAFF}\x{2190}-\x{21FF}\x{2600}-\x{27BF}\x{2B00}-\x{2BFF}\x{FE0F}\x{1F1E6}-\x{1F1FF}]'

fautes=0

signaler() {
  printf '%s  ligne %s%s : %s\n' "$ROUGE" "$1" "$RAZ" "$3"
  printf '%s    %s%s\n' "$GRIS" "$2" "$RAZ"
  fautes=$((fautes + 1))
}

ligne_num=0
while IFS= read -r ligne || [ -n "$ligne" ]; do
  ligne_num=$((ligne_num + 1))

  # Les lignes de commentaire produites par git ne font pas partie du message.
  case "$ligne" in \#*) continue ;; esac

  for motif in "${MOTIFS_INTERDITS[@]}"; do
    if printf '%s' "$ligne" | grep -qiE "$motif"; then
      signaler "$ligne_num" "$ligne" "mention d'un outil d'IA interdite (motif : $motif)"
      break
    fi
  done

  if printf '%s' "$ligne" | grep -qP "$MOTIF_EMOJI" 2>/dev/null; then
    signaler "$ligne_num" "$ligne" "emoji interdit dans un message de commit"
  fi
done < "$MSG_FILE"

if [ "$fautes" -gt 0 ]; then
  printf '\n%s================================================%s\n' "$ROUGE" "$RAZ"
  printf '%s COMMIT REFUSÉ — %s ligne(s) non conforme(s)%s\n' "$ROUGE" "$fautes" "$RAZ"
  printf '%s================================================%s\n\n' "$ROUGE" "$RAZ"
  printf '%sRègle du projet (docs/02-CONVENTIONS.md) :%s\n' "$JAUNE" "$RAZ"
  printf "  L'historique Git ne mentionne jamais d'outil d'IA, et ne contient aucun emoji.\n"
  printf '  Corrige le message ci-dessus, puis relance le commit.\n\n'
  exit 1
fi

# Passe 2 — Conventional Commits. Ignorée si les dépendances ne sont pas installées.
if [ -x node_modules/.bin/commitlint ]; then
  if ! node_modules/.bin/commitlint --edit "$MSG_FILE"; then
    printf '\n%sCOMMIT REFUSÉ — message non conforme à Conventional Commits.%s\n' "$ROUGE" "$RAZ"
    printf 'Format attendu : type(scope): sujet à l'\''impératif, minuscule, sans point final.\n'
    printf 'Types et scopes autorisés : voir commitlint.config.js et docs/02-CONVENTIONS.md.\n\n'
    exit 1
  fi
fi

exit 0
